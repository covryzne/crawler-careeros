# TEMPLATE ONLY - development. Selenium does NOT require LLM keys or DATABASE_URL.
# CLI default mode is browser-use; pass --mode selenium explicitly for Selenium.
SEARCH_KEYWORD=REPLACE_WITH_LOCAL_SEARCH_KEYWORD

# Optional Browser Use experiment only; uncomment ONE provider configuration.
# LLM_PROVIDER=google
# GOOGLE_API_KEY=REPLACE_WITH_LOCAL_GOOGLE_API_KEY
# GOOGLE_MODEL=REPLACE_WITH_GOOGLE_MODEL
# Alternative: LLM_PROVIDER=browser_use plus BROWSER_USE_API_KEY.
# BROWSER_USE_API_KEY=REPLACE_WITH_LOCAL_BROWSER_USE_API_KEY

# Browser Use limits only. Selenium limits/browser/output are CLI/job parameters.
MAX_SEARCH_PAGES=1
MAX_SOURCES=3
MAX_JOBS_PER_SOURCE=3
DISCOVERY_STEPS=20
EXPLORER_STEPS=40
# See specs-careeros/ENVIRONMENT_VARIABLES.md.

# Shared global execution capacity; replicate workers separately for parallel runs.
CRAWLER_MAX_CONCURRENCY=1

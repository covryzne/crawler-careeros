# TEMPLATE ONLY - standalone local CLI. Copy to ignored .env and fill privately.
# The CLI uses load_dotenv(): it does not automatically select .env.development.
# Default mode is browser-use; use --mode selenium for deterministic adapters.
# Selenium CLI needs NO database, Supabase Auth or LLM credentials.
SEARCH_KEYWORD=REPLACE_WITH_SEARCH_KEYWORD

# Browser Use only, local experiments. Uncomment one provider and fill its key.
# LLM_PROVIDER=google
# GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY
# GOOGLE_MODEL=REPLACE_WITH_GOOGLE_MODEL
# Alternative: LLM_PROVIDER=browser_use with BROWSER_USE_API_KEY.
# BROWSER_USE_API_KEY=REPLACE_WITH_BROWSER_USE_API_KEY
MAX_SEARCH_PAGES=1
MAX_SOURCES=3
MAX_JOBS_PER_SOURCE=3
DISCOVERY_STEPS=20
EXPLORER_STEPS=40
# These limits are Browser Use only. Selenium uses CLI/job page/day/job parameters.

# Integrated worker Compose instead reads the BACKEND private env via --env-file.
# Keep DATABASE_URL, portal policy and concurrency in that backend env only.
# In native mode, configure APP_ENV_FILE in each backend worker/dispatcher terminal.
# Development Compose replica count currently uses --scale crawler-worker=N.

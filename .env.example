LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite
# Or LLM_PROVIDER=browser_use with BROWSER_USE_API_KEY
# Shared default keyword. Selenium mode does not require either LLM key.
SEARCH_KEYWORD=AI Engineer loker
# The limits below apply to Browser Use; Selenium uses CLI options.
MAX_SEARCH_PAGES=1
MAX_SOURCES=3
MAX_JOBS_PER_SOURCE=3
DISCOVERY_STEPS=20
EXPLORER_STEPS=40

# Shared global execution capacity; replicate workers separately for parallel runs.
CRAWLER_MAX_CONCURRENCY=1
